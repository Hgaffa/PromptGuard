[flake8]
max-line-length = 88
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    build,
    dist,
    *.egg-info
per-file-ignores =
    # __init__.py re-exports are intentional F401 (imported but unused)
    promptguard/__init__.py: F401
    promptguard/__init__.pyi: F401
